SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///wedding_planner.db

# Pricing rules
FREE_BUDGET_ITEM_LIMIT=4
OWNER_PLAN_PRICE=4.00
STAKEHOLDER_PRICE=3.00

# MojaPOS / MTN MoMo
MOJAPOS_API_URL=https://mojapos.com/api
MOJAPOS_API_KEY=replace-with-your-mojapos-api-key
MOJAPOS_WEBHOOK_SECRET=replace-with-your-mojapos-webhook-secret
MOJAPOS_VERIFY_WEBHOOK_SIGNATURE=false
MOJAPOS_PROVIDER=MTN_MOMO
MOJAPOS_CURRENCY=SZL
MOJAPOS_INITIATE_PATH=/payments/pay
MOJAPOS_CALLBACK_PATH=/api/payment/callback

# Local proofing only. Set both to false in production.
MOJAPOS_MOCK_MODE=false
MOJAPOS_MOCK_AUTO_COMPLETE=false

# Realtime updates. Leave blank when running one Gunicorn worker.
# For a multi-process deployment, install Redis and use redis://127.0.0.1:6379/0.
SOCKETIO_MESSAGE_QUEUE=

# Privacy-conscious admin request diagnostics (rotating log files).
ANALYTICS_ENABLED=true
# Leave blank to use instance/analytics.log.
ANALYTICS_LOG_PATH=
ANALYTICS_LOG_MAX_BYTES=2097152
ANALYTICS_LOG_BACKUP_COUNT=3
